# Copia este archivo como `.env.local` y complétalo con los valores de tu
# proyecto de Supabase. `.env*` ya está en .gitignore: nunca se versiona.
#
# En Vercel, estas mismas variables se cargan en Settings → Environment
# Variables. Las que llevan NEXT_PUBLIC_ viajan al navegador; las demás, no.

# -----------------------------------------------------------------------------
# Públicas (llegan al cliente)
# -----------------------------------------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Llave anónima. Es pública por diseño y no otorga acceso por sí sola: quien la
# tenga sólo puede hacer lo que permitan las políticas RLS de 0004_rls.sql, es
# decir, insertar respuestas en un ciclo abierto y leer los catálogos. No puede
# leer una sola respuesta.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# -----------------------------------------------------------------------------
# Privadas (sólo servidor)
# -----------------------------------------------------------------------------
# Llave de servicio: IGNORA todas las políticas RLS. Nunca debe llevar el
# prefijo NEXT_PUBLIC_, nunca importarse desde un componente de cliente y nunca
# aparecer en el repositorio. Sólo hace falta para tareas administrativas
# (sembrar catálogos, alta de personal, respaldos).
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa, para correr las migraciones con psql o supabase
# CLI. Supabase → Project Settings → Database → Connection string.
SUPABASE_DB_URL=
